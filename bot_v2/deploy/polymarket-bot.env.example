# Copy to deploy/polymarket-bot.env and fill values. Never commit the filled file.
# Every value stays environment-only; nothing below may contain a real secret.

# Wallet and trading credentials (live mode). Leave empty for dry run.
#POLYMARKET_PRIVATE_KEY=
#CLOB_API_KEY=
#CLOB_SECRET=
#CLOB_PASSPHRASE=
#POLYMARKET_PROXY_ADDRESS=
#RPC_URL=

# Operator notifications (required before issuing a live operating lease).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# Optional overrides.
#BOT_DATA_DIR=/var/lib/polymarket-bot
#BOT_HEALTHCHECK_MAX_AGE_SECONDS=120
